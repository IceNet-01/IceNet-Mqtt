{
  "name": "icenet-mqtt",
  "version": "1.0.0",
  "description": "Fully featured self-hosted MQTT server for Meshtastic devices and Reticulum network",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "mqtt",
    "meshtastic",
    "reticulum",
    "iot",
    "mesh-network",
    "broker"
  ],
  "author": "IceNet",
  "license": "MIT",
  "dependencies": {
    "aedes": "^0.51.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "mqtt": "^5.3.4",
    "protobufjs": "^7.2.5",
    "serialport": "^12.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.25",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
